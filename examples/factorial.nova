func factorial(int: n) -> int {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

func main() -> int {
    let int: x = 10;
    let int[5]: arr = [1, 2, 3, 4, 5];
    let int: sum = 0;

    for (let int: i = 0; i < 5; i = i + 1) {
        sum = sum + arr[i];
    }

    print(factorial(x));
    print(sum);
    return 0;
}
