// All int arithmetic operators, including C-truncating division/modulo
// semantics for negative operands (decisions.md #12).
func main() -> int {
    print(7 + 3);
    print(7 - 3);
    print(7 * 3);
    print(7 / 3);
    print(7 % 3);
    print(0 - 7 / 2);   // truncates toward zero: -3, not Python's -4
    print(0 - 7 % 2);   // sign follows dividend: -1
    return 0;
}
