// Float arithmetic. No implicit int/float conversion anywhere
// (decisions.md #4) - every operand here is a float literal.
func main() -> int {
    let float: a = 7.0;
    let float: b = 2.0;
    print(a + b);
    print(a - b);
    print(a * b);
    print(a / b);
    print(a % b);
    return 0;
}
